# CRMS Root Environment Configuration Example

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend Configuration
DATABASE_URL=sqlite:///./crms_dev.db
JWT_SECRET_KEY=crms-doj-super-secret-key-change-in-production-2026
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
STORAGE_DIR=./storage

# Cloudflare R2 Cloud Storage Configuration (100% Free - 10GB Monthly, $0 Egress)
# Obtain these credentials from your Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=netra-crms-storage
R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev
